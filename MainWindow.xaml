<Window x:Class="AkkDictionaryApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AKK En-to-MM Dictionary" Height="760" Width="1120"
        Background="{DynamicResource WindowBg}"
        Closing="Window_Closing">

    <DockPanel Background="{DynamicResource WindowBg}">

        <!-- Menu bar -->
        <Menu DockPanel.Dock="Top"
              Background="{DynamicResource SurfaceBg}"
              Foreground="{DynamicResource TextPrimary}">
            <MenuItem Header="_File" Foreground="{DynamicResource TextPrimary}">
                <MenuItem Header="Rebuild database from Excel..." Click="RebuildFromExcel_Click"/>
                <MenuItem Header="Import from SQLite..."         Click="ImportFromSqlite_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_View" Foreground="{DynamicResource TextPrimary}">
                <MenuItem Header="Search in definitions (Myanmar→English)" IsCheckable="True"
                          x:Name="ReverseSearchMenu"
                          Checked="ReverseSearchMenu_Checked"
                          Unchecked="ReverseSearchMenu_Unchecked"/>
                <Separator/>
                <MenuItem Header="Dark Mode" IsCheckable="True"
                          x:Name="DarkModeMenu"
                          Click="DarkModeMenu_Click"/>
            </MenuItem>
            <MenuItem Header="_Settings" Click="OpenSettings_Click"
                      Foreground="{DynamicResource TextPrimary}"/>
            <MenuItem Header="_Help" Foreground="{DynamicResource TextPrimary}">
                <MenuItem Header="About" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="{DynamicResource StatusBg}"
                   Foreground="{DynamicResource StatusFg}">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="EntryCountText"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Search bar -->
        <Border DockPanel.Dock="Top"
                Background="{DynamicResource SurfaceBg}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SearchBox" Grid.Row="0"
                             Width="540" Height="34" Margin="0,0,8,0"
                             VerticalContentAlignment="Center"
                             Background="{DynamicResource SearchBg}"
                             Foreground="{DynamicResource TextPrimary}"
                             CaretBrush="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource SearchBorder}"
                             FontFamily="Myanmar Text"
                             TextChanged="SearchBox_TextChanged"
                             KeyDown="SearchBox_KeyDown"
                             GotFocus="SearchBox_GotFocus"
                             ToolTip="Type a word — Ctrl+L to focus, Escape to clear"/>
                    <ListBox x:Name="SuggestList" Grid.Row="1"
                             Width="540" MaxHeight="200"
                             Visibility="Collapsed"
                             Background="{DynamicResource SuggestBg}"
                             Foreground="{DynamicResource TextPrimary}"
                             BorderBrush="{DynamicResource SearchBorder}"
                             Panel.ZIndex="10"
                             MouseDoubleClick="SuggestList_MouseDoubleClick"/>
                </Grid>
                <CheckBox x:Name="ReverseSearchToggle"
                          Content="MM→EN" Margin="8,0"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource TextPrimary}"
                          Checked="ReverseSearchToggle_CheckedChanged"
                          Unchecked="ReverseSearchToggle_CheckedChanged"/>
                <Button Content="Clear" Width="60" Click="Clear_Click"
                        Style="{DynamicResource ToolBtn}"/>
                <Button Content="Bookmarks" Width="90" Click="ShowBookmarks_Click"
                        Style="{DynamicResource ToolBtn}"/>
            </StackPanel>
        </Border>

        <!-- Query label (shown after a search) -->
        <Border x:Name="QueryLabelBorder" DockPanel.Dock="Top"
                Background="{DynamicResource QueryLabelBg}"
                Padding="12,4" Visibility="Collapsed">
            <TextBlock x:Name="QueryLabel"
                       Foreground="{DynamicResource TextAccent}"
                       FontStyle="Italic" FontSize="12"/>
        </Border>

        <!-- Fuzzy "did you mean" bar (shown when 0 exact results) -->
        <Border x:Name="FuzzyBorder" DockPanel.Dock="Top"
                Background="{DynamicResource FuzzyBg}"
                Padding="12,6" Visibility="Collapsed">
            <TextBlock x:Name="FuzzyText"
                       Foreground="{DynamicResource TextFuzzy}"
                       FontStyle="Italic" TextWrapping="Wrap"/>
        </Border>

        <!-- Main content: list | splitter | detail -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="420" MinWidth="180"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="200"/>
            </Grid.ColumnDefinitions>

            <!-- Results list -->
            <ListView x:Name="ResultsList" Grid.Column="0"
                      ItemContainerStyle="{DynamicResource ListViewItemStyle}"
                      Background="{DynamicResource ListBg}"
                      Foreground="{DynamicResource TextPrimary}"
                      BorderBrush="{DynamicResource DividerBrush}"
                      SelectionChanged="ResultsList_SelectionChanged">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="" Width="26">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding BookmarkStar}"
                                               Foreground="{DynamicResource TextAccent}"
                                               HorizontalAlignment="Center"
                                               FontSize="13"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="Headword" Width="200">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DisplayHeadword}"
                                               Foreground="{DynamicResource TextHeadword}"
                                               FontWeight="SemiBold"
                                               FontFamily="Myanmar Text"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="POS"  Width="90"  DisplayMemberBinding="{Binding Pos}"/>
                        <GridViewColumn Header="#"    Width="36"  DisplayMemberBinding="{Binding Senses}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Draggable splitter -->
            <GridSplitter Grid.Column="1" Width="5"
                          Background="{DynamicResource SplitterBg}"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"/>

            <!-- Detail pane -->
            <Border Grid.Column="2"
                    Background="{DynamicResource DetailPaneBg}"
                    BorderBrush="{DynamicResource DividerBrush}"
                    BorderThickness="1,0,0,0">
                <DockPanel>

                    <!-- Entry header: headword + POS + action buttons -->
                    <Border x:Name="DetailHeader" DockPanel.Dock="Top"
                            Background="{DynamicResource SurfaceBg}"
                            BorderBrush="{DynamicResource DividerBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="14,10"
                            Visibility="Collapsed">
                        <DockPanel>
                            <!-- Buttons on the right -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <Button x:Name="BookmarkBtn" Content="☆"
                                        ToolTip="Bookmark this entry"
                                        Style="{DynamicResource ToolBtn}" Width="36"
                                        Click="BookmarkBtn_Click"/>
                                <Button x:Name="SpeakBtn" Content="&#x1F50A;"
                                        ToolTip="Read aloud (TTS)"
                                        Style="{DynamicResource ToolBtn}" Width="36"
                                        Click="SpeakBtn_Click"/>
                                <Button x:Name="CopyBtn" Content="&#x2398;"
                                        ToolTip="Copy definitions to clipboard"
                                        Style="{DynamicResource ToolBtn}" Width="36"
                                        Click="CopyBtn_Click"/>
                            </StackPanel>
                            <!-- Headword + POS -->
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="DetailHeadword"
                                           FontSize="22" FontWeight="Bold"
                                           Foreground="{DynamicResource TextHeadword}"
                                           FontFamily="Myanmar Text"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="DetailPos"
                                           Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextSecondary}"
                                           FontStyle="Italic"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Scrollable definition area -->
                    <ScrollViewer Margin="14,10">
                        <ItemsControl x:Name="SensesPanel"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
